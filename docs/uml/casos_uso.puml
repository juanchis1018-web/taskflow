@startuml casos_uso
title Diagrama de casos de uso - TaskFlow
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
left to right direction
actor "Visitante" as vis
actor "Usuario registrado" as usr
actor "Administrador" as adm
actor "Cliente de la API\n(sistema externo)" as ext
usr <|-- adm

rectangle "TaskFlow" {
  usecase "CU-01 Registrarse" as cu1
  usecase "CU-02 Iniciar sesión" as cu2
  usecase "CU-03 Cerrar sesión" as cu3
  usecase "CU-04 Crear tarea" as cu4
  usecase "CU-05 Consultar y buscar tareas" as cu5
  usecase "CU-06 Completar / reabrir tarea" as cu6
  usecase "CU-07 Eliminar tarea" as cu7
  usecase "CU-08 Ver estadísticas de avance" as cu8
  usecase "CU-09 Editar perfil" as cu9
  usecase "CU-10 Eliminar cuenta" as cu10
  usecase "CU-11 Administrar usuarios" as cu11
  usecase "CU-12 Gestionar tareas por API REST" as cu12
  usecase "Validar datos" as val
}
vis --> cu1
vis --> cu2
usr --> cu3
usr --> cu4
usr --> cu5
usr --> cu6
usr --> cu7
usr --> cu8
usr --> cu9
usr --> cu10
adm --> cu11
ext --> cu12
cu1 ..> val : <<include>>
cu4 ..> val : <<include>>
cu9 ..> val : <<include>>
cu5 <.. cu8 : <<extend>>
@enduml
